              <div className="mb-6">
                <p className="text-[10px] font-semibold uppercase tracking-[0.18em] text-[#a45d42]">
                  What's included
                </p>
                <h2 className="mt-2 font-serif text-2xl text-[#233b35] dark:text-[#f5f1ea] sm:text-3xl">
                  Studio amenities
                </h2>
              </div>

              {studio.amenities.length > 0 ? (
                <div className="grid gap-x-8 gap-y-4 sm:grid-cols-2">
                  {studio.amenities.map((amenity) => (
                    <div
                      key={amenity}
                      className="flex items-center gap-3 text-sm text-[#66736d] dark:text-[#b3beb8]"
                    >
                      <span className="flex h-6 w-6 shrink-0 items-center justify-center bg-[#e9f0eb] text-[#557564] dark:bg-white/[0.07] dark:text-[#a9c8b6]">
                        <Check className="h-3.5 w-3.5" />
                      </span>
                      {amenity}
                    </div>
                  ))}
                </div>
              ) : (
                <p className="text-sm leading-7 text-[#66736d] dark:text-[#b3beb8]">
                  No amenities have been listed for this studio yet.
                </p>
              )}
            </section>

            {/* Owner */}
            <section className="py-8 sm:py-10">
              <div className="mb-6">
                <p className="text-[10px] font-semibold uppercase tracking-[0.18em] text-[#a45d42]">
                  Your host
                </p>
                <h2 className="mt-2 font-serif text-2xl text-[#233b35] dark:text-[#f5f1ea] sm:text-3xl">
                  Meet the studio owner
                </h2>
              </div>

              <div className="flex flex-col gap-5 border border-[#233b35]/10 bg-white/60 p-5 dark:border-white/10 dark:bg-white/2.5 sm:flex-row sm:items-center sm:p-6">
                <div className="relative flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-full bg-[#e9e3d9] text-lg font-semibold text-[#233b35] dark:bg-white/10 dark:text-[#f5f1ea]">
                  {studio.ownerPhotoURL ? (
                    <Image
                      src={studio.ownerPhotoURL}
                      alt={ownerName}
                      fill
                      sizes="64px"
                      className="object-cover"
                    />
                  ) : (
                    getInitials(ownerName)
                  )}
                </div>

                <div className="min-w-0 flex-1">
                  <div className="flex flex-wrap items-center gap-2">
                    <h3 className="text-base font-semibold text-[#233b35] dark:text-[#f5f1ea]">
                      {ownerName}
                    </h3>
                    <BadgeCheck className="h-4 w-4 text-[#a45d42]" />
                  </div>

                  <p className="mt-1 text-sm text-[#66736d] dark:text-[#b3beb8]">
                    Studio owner
                  </p>

                  {hasOwnerEmail && (
                    <p className="mt-2 break-all text-xs text-[#87928c] dark:text-[#8d9b94]">
                      {studio.ownerEmail}
                    </p>
                  )}
                </div>

                {hasOwnerEmail && (
                  <a
                    href={`mailto:${studio.ownerEmail}?subject=${encodeURIComponent(
                      `Inquiry about ${studio.title}`
                    )}`}
                    className="inline-flex shrink-0 items-center justify-center gap-2 border border-[#233b35]/15 px-4 py-3 text-sm font-semibold text-[#233b35] transition hover:border-[#a45d42] hover:text-[#a45d42] dark:border-white/15 dark:text-[#f5f1ea] dark:hover:border-[#d59a7d] dark:hover:text-[#d59a7d]"
                  >
                    <Mail className="h-4 w-4" />
                    Contact owner
                  </a>
                )}
              </div>
            </section>
          </div>

          {/* Pricing sidebar */}
          <aside className="lg:sticky lg:top-8">
            <div className="border border-[#233b35]/10 bg-white p-6 dark:border-white/10 dark:bg-[#18231f] sm:p-7">
              <p className="text-[10px] font-semibold uppercase tracking-[0.18em] text-[#a45d42]">
                Rental information
              </p>

              <div className="mt-4 border-b border-[#233b35]/10 pb-6 dark:border-white/10">
                <p className="text-sm text-[#87928c] dark:text-[#8d9b94]">
                  Starting from
                </p>

                <div className="mt-1 flex items-baseline gap-2">
                  <span className="font-serif text-4xl text-[#233b35] dark:text-[#f5f1ea]">
                    {formatPrice(studio.hourlyRate)}
                  </span>
                  <span className="text-sm text-[#66736d] dark:text-[#b3beb8]">
                    / hour
                  </span>
                </div>
              </div>

              <div className="space-y-5 py-6">
                <div className="flex items-center justify-between gap-3">
                  <span className="text-sm text-[#66736d] dark:text-[#b3beb8]">
                    Hourly rental
                  </span>
                  <span className="text-sm font-semibold text-[#233b35] dark:text-[#f5f1ea]">
                    {formatPrice(studio.hourlyRate)}
                  </span>
                </div>

                <div className="flex items-center justify-between gap-3">
                  <span className="text-sm text-[#66736d] dark:text-[#b3beb8]">
                    Security deposit
                  </span>
                  <span className="text-sm font-semibold text-[#233b35] dark:text-[#f5f1ea]">
                    {formatPrice(studio.securityDeposit)}
                  </span>
                </div>

                <div className="flex items-center justify-between gap-3">
                  <span className="text-sm text-[#66736d] dark:text-[#b3beb8]">
                    Capacity
                  </span>
                  <span className="text-sm font-semibold text-[#233b35] dark:text-[#f5f1ea]">
                    {studio.capacity} people
                  </span>
                </div>

                <div className="flex items-center justify-between gap-3">
                  <span className="text-sm text-[#66736d] dark:text-[#b3beb8]">
                    Availability
                  </span>
                  <span className="inline-flex items-center gap-1.5 text-sm font-semibold text-[#557564] dark:text-[#a9c8b6]">
                    <span className="h-1.5 w-1.5 rounded-full bg-[#6c9b79]" />
                    {studio.status || "Available"}
                  </span>
                </div>
              </div>

              <div className="border-t border-[#233b35]/10 pt-6 dark:border-white/10">
                {hasOwnerEmail ? (
                  <a
                    href={`mailto:${studio.ownerEmail}?subject=${encodeURIComponent(
                      `Booking inquiry: ${studio.title}`
                    )}`}
                    className="flex w-full items-center justify-center gap-2 bg-[#233b35] px-5 py-4 text-sm font-semibold text-white transition hover:bg-[#344f46] dark:bg-[#f5f1ea] dark:text-[#233b35] dark:hover:bg-white"
                  >
                    Contact studio owner
                    <ArrowUpRight className="h-4 w-4" />
