              </p>
            </div>

            {/* Studio highlights */}
            <div className="grid grid-cols-2 gap-4 border-b border-[#233b35]/10 py-7 dark:border-white/10 sm:grid-cols-3 sm:gap-6">
              <div className="flex items-start gap-3">
