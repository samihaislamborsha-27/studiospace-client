                </div>
              </div>

              <div className="col-span-2 flex items-start gap-3 sm:col-span-1">
                <div className="flex h-10 w-10 shrink-0 items-center justify-center bg-[#f1eae1] text-[#a45d42] dark:bg-white/6">
                  <ShieldCheck className="h-5 w-5" />
                </div>
                <div>
                  <p className="text-xs text-[#87928c] dark:text-[#8d9b94]">
                    Listing status
                  </p>
                  <p className="mt-1 text-sm font-semibold text-[#233b35] dark:text-[#f5f1ea]">
                    {studio.status || "Available"}
                  </p>
                </div>
              </div>
            </div>

            {/* Overview */}
            <section className="border-b border-[#233b35]/10 py-8 dark:border-white/10 sm:py-10">
              <div className="mb-5">
                <p className="text-[10px] font-semibold uppercase tracking-[0.18em] text-[#a45d42]">
