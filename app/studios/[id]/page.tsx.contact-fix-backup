function StudioDetailsContent() {
  const params = useParams<{ id: string }>();
  const studioId = params?.id;

  const [studio, setStudio] = useState<Studio | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  useEffect(() => {
    let isMounted = true;

    async function loadStudio() {
      if (!studioId) {
        setLoading(false);
        setError("The studio could not be identified.");
        return;
      }

      setLoading(true);
      setError("");

      try {
        const result = await getStudioById(studioId);

        if (!isMounted) return;

        if (!result) {
          setStudio(null);
          setError("This studio may have been removed or is no longer available.");
          return;
        }

        setStudio(result);
      } catch (err) {
        if (!isMounted) return;

        setError(
          err instanceof Error
            ? err.message
            : "Something went wrong while loading this studio."
        );
      } finally {
        if (isMounted) {
          setLoading(false);
        }
      }
    }

    loadStudio();

    return () => {
      isMounted = false;
    };
  }, [studioId]);

  if (loading) {
    return <LoadingState />;
  }

  if (error || !studio) {
    return (
      <EmptyState
        title="Studio not found"
        description={
          error ||
          "We couldn't find the studio you're looking for. It may no longer be available."
        }
      />
    );
  }

  const ownerName = studio.ownerName?.trim() || "Studio owner";
  const hasOwnerEmail = Boolean(studio.ownerEmail?.trim());

  return (
    <div className="min-h-screen bg-[#fbfaf7] pb-16 dark:bg-[#111a17]">
      <div className="mx-auto w-full max-w-7xl px-5 pt-7 sm:px-8 sm:pt-10 lg:px-10">
        {/* Breadcrumb */}
        <div className="mb-7 flex flex-wrap items-center justify-between gap-4">
          <Link
            href="/studios"
            className="inline-flex items-center gap-2 text-sm font-medium text-[#66736d] transition hover:text-[#a45d42] dark:text-[#b3beb8] dark:hover:text-[#d59a7d]"
          >
            <ArrowLeft className="h-4 w-4" />
            Back to studios
          </Link>

          <div className="flex items-center gap-2 text-xs text-[#87928c] dark:text-[#8d9b94]">
            <Link href="/" className="transition hover:text-[#a45d42]">
              Home
            </Link>
            <span>/</span>
            <Link href="/studios" className="transition hover:text-[#a45d42]">
              Studios
            </Link>
            <span>/</span>
            <span className="max-w-32 truncate text-[#233b35] dark:text-[#f5f1ea]">
              {studio.title}
            </span>
          </div>
        </div>

        <div className="grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_360px] lg:gap-12">
          {/* Main content */}
          <div className="min-w-0">
            {/* Main image */}
            <div className="group relative aspect-16/10 overflow-hidden bg-[#e5e0d7] dark:bg-white/10 sm:aspect-video">
              {studio.image ? (
                <Image
                  src={studio.image}
                  alt={studio.title}
                  fill
                  priority
                  sizes="(max-width: 1024px) 100vw, 70vw"
                  className="object-cover"
                />
              ) : (
                <div className="flex h-full items-center justify-center text-[#66736d] dark:text-[#b3beb8]">
                  <div className="text-center">
                    <ImageOff className="mx-auto h-9 w-9" />
                    <p className="mt-3 text-sm">Studio image unavailable</p>
                  </div>
                </div>
              )}

              <div className="absolute inset-0 bg-linear-to-t from-black/35 via-transparent to-black/5" />

              {studio.featured && (
                <span className="absolute left-5 top-5 inline-flex items-center gap-2 bg-[#f5f1ea] px-3.5 py-2 text-[10px] font-semibold uppercase tracking-[0.14em] text-[#233b35]">
                  <Star className="h-3.5 w-3.5 fill-[#a45d42] text-[#a45d42]" />
                  Featured studio
                </span>
              )}

              <span className="absolute bottom-5 left-5 bg-[#233b35] px-4 py-2 text-xs font-medium text-white">
                {studio.category}
              </span>
            </div>

            {/* Title and basic information */}
            <div className="border-b border-[#233b35]/10 py-7 dark:border-white/10 sm:py-9">
