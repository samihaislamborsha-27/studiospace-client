                  <div className="bg-[#f5f1ea] px-4 py-4 text-center text-sm text-[#66736d] dark:bg-white/6 dark:text-[#b3beb8]">
                    Owner contact information is unavailable.
                  </div>
                )}

                <p className="mt-4 text-center text-xs leading-6 text-[#87928c] dark:text-[#8d9b94]">
                  Contact the owner to discuss availability, booking details
                  and studio requirements.
                </p>
              </div>
            </div>

            {/* Trust note */}
            <div className="mt-5 flex gap-3 border border-[#233b35]/10 px-5 py-5 dark:border-white/10">
              <ShieldCheck className="mt-0.5 h-5 w-5 shrink-0 text-[#a45d42]" />
              <div>
                <p className="text-sm font-semibold text-[#233b35] dark:text-[#f5f1ea]">
                  Plan with confidence
                </p>
                <p className="mt-1 text-xs leading-6 text-[#66736d] dark:text-[#b3beb8]">
                  Confirm rental terms, availability and deposit details with
                  the studio owner before arranging your visit.
                </p>
              </div>
            </div>
          </aside>
        </div>

        {/* Contact owner dialog */}
        {contactOpen && hasOwnerEmail && (
          <div
            className="fixed inset-0 z-[100] flex items-center justify-center bg-[#101713]/65 p-4 backdrop-blur-sm"
            onMouseDown={(event) => {
              if (event.target === event.currentTarget) {
                setContactOpen(false);
              }
            }}
          >
            <section
              role="dialog"
              aria-modal="true"
              aria-labelledby="contact-dialog-title"
              className="relative w-full max-w-md border border-[#e7e0d6] bg-white p-6 shadow-2xl dark:border-white/10 dark:bg-[#222724] sm:p-8"
            >
              <button
                type="button"
                onClick={() => setContactOpen(false)}
                aria-label="Close contact dialog"
                className="absolute right-4 top-4 flex h-9 w-9 items-center justify-center text-[#52615a] transition hover:bg-[#f1eee8] hover:text-[#233b35] dark:text-[#b3beb8] dark:hover:bg-white/10 dark:hover:text-white"
              >
                <X className="h-5 w-5" />
