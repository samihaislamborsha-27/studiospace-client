        )}

        {/* Bottom navigation */}
        <div className="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-[#233b35]/10 pt-6 dark:border-white/10">
          <p className="text-sm text-[#66736d] dark:text-[#b3beb8]">
