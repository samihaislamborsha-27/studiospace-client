import type { Studio } from "@/lib/studios";

function formatPrice(value: number) {
  return `৳${value.toLocaleString("en-BD")}`;
}

function getInitials(name?: string) {
  if (!name?.trim()) return "SO";

  return name
    .trim()
    .split(/\s+/)
    .slice(0, 2)
    .map((part) => part.charAt(0).toUpperCase())
    .join("");
}

